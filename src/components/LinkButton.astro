---
// Replaces Quarto's `[text](url){.btn .btn-outline-primary .btn-sm}` links.
interface Props {
  href: string;
  variant?: 'solid' | 'ghost';
  external?: boolean;
  class?: string;
}
const { href, variant = 'ghost', external, class: klass } = Astro.props;
const isExternal = external ?? /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['btn', 'btn--sm', { 'btn--ghost': variant === 'ghost' }, klass]}
  {...isExternal ? { target: '_blank', rel: 'noopener' } : {}}
>
  <slot />
</a>
