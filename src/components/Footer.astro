---
import { socials, site } from '@/lib/site';
import Icon from './Icon.astro';
const year = 2026;
const iconSocials = socials.filter((s) => s.key !== 'email');
---
<footer class="footer" data-pagefind-ignore>
  <div class="footer__inner container">
    <div class="footer__meta">
      <span class="eyebrow">© {year} {site.shortName}</span>
      <span class="footer__tag">SAR · complex-valued ML · geospatial FMs</span>
    </div>
    <div class="footer__links">
      {iconSocials.map((s) => (
        <a class="footer__link" href={s.href} target="_blank" rel="me noopener" aria-label={s.label}>
          <Icon name={s.key as any} />
        </a>
      ))}
      <a class="footer__link" href="/blog.xml" aria-label="RSS feed"><Icon name="rss" /></a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--sp-10);
    border-top: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-6);
  }
  .footer__meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .footer__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: 0.06em;
    color: var(--mist);
  }
  .footer__links { display: flex; gap: var(--sp-4); font-size: 1.15rem; }
  .footer__link { color: var(--mist); display: inline-grid; place-items: center; }
  .footer__link:hover { color: var(--forest); }
</style>
