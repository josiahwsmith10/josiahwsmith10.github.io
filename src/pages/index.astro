---
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import { Image } from 'astro:assets';

// Author portrait, rendered as Fig. 2 when a real photo lands in src/assets/.
const authorPics = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/author.{jpg,jpeg,png}',
  { eager: true },
);
const authorPic = Object.values(authorPics)[0]?.default;

const threads = [
  {
    title: 'Phase-aware SAR learning',
    body: 'Most SAR pipelines discard phase before the first layer and train on intensity alone. I build complex-valued, coherence-preserving models that keep the phase and use it for change detection.',
    tag: 'complex-valued · InSAR',
  },
  {
    title: 'Foundation models on new sensors',
    body: 'Every public geospatial foundation model was pretrained on C-band SAR, and NISAR is L-band. I’m measuring where that transfer breaks and where it holds, then closing the gap.',
    tag: 'geo-FMs · NISAR',
  },
  {
    title: 'Remote sensing for good',
    body: 'The Colombian Amazon is under cloud half the year, and optical deforestation alerts go quiet during those months. I’m building a SAR companion system to catch what the operational alerts miss.',
    tag: 'Earth observation · impact',
  },
];
---

<Base>
  <Hero />

  <section class="threads container">
    <div class="rule-label">
      <span class="eyebrow">Research threads</span>
      <span class="eyebrow" style="color:var(--signal-ink)">current focus</span>
    </div>
    <ol class="threads__list">
      {
        threads.map((t) => (
          <li class="thread">
            <span class="thread__tag">{t.tag}</span>
            <div class="thread__body">
              <h3 class="thread__title">{t.title}</h3>
              <p class="thread__text">{t.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="now container">
    <div class="now__grid measure-wide">
      <div class="now__text-col">
        <p class="eyebrow">Now</p>
        <p class="now__lead">
          I'm an <strong>AI Computer Vision Scientist at Privateer&nbsp;Space</strong>, where I
          architected a no-code geospatial ML platform that takes non-experts from raw satellite
          data to deployed models. Before Privateer I worked at KBR, Microsoft, Apple, IMEC, and
          Texas&nbsp;Instruments.
        </p>
        <p class="now__text">
          Most of my career has focused on commercial and government applications of niche sensing
          modalities. The work I care most about is AI for good: sustainable, local-scale solutions
          to humanitarian, agricultural, and environmental problems. <a href="/cv"
            >The full record is in the CV →</a
          >
        </p>
      </div>
      {
        authorPic && (
          <figure class="now__fig">
            <div class="now__fig-frame">
              <Image
                src={authorPic}
                alt="Portrait of Josiah W. Smith"
                widths={[320, 640]}
                sizes="16rem"
              />
            </div>
            <figcaption class="now__fig-cap">Fig.&nbsp;2 — The author.</figcaption>
          </figure>
        )
      }
    </div>
  </section>
</Base>

<style>
  .threads {
    margin-top: var(--sp-9);
  }
  .threads__list {
    list-style: none;
    padding: 0;
  }
  /* Index-term rows: the domain tag sits in a left margin column, like the
     index terms of a paper — classification, not sequence. */
  .thread {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    column-gap: var(--sp-6);
    padding-block: var(--sp-5);
  }
  .thread:first-child {
    padding-top: 0;
  }
  .thread + .thread {
    border-top: 1px solid var(--rule);
  }
  .thread__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: 0.05em;
    color: var(--mist);
    text-transform: uppercase;
    padding-top: 0.55em; /* optically align with the serif title's cap height */
  }
  .thread__title {
    font-size: var(--fs-lg);
  }
  .thread__text {
    margin-top: var(--sp-2);
    color: var(--ink-soft);
    max-width: var(--prose-max);
  }

  .now {
    margin-top: var(--sp-9);
  }
  .measure-wide {
    max-width: 54rem;
  }
  .now__grid {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-7);
  }
  .now__text-col {
    flex: 1;
  }
  .now__fig {
    flex: none;
    width: 15rem;
    margin: 0;
  }
  .now__fig-frame {
    border: 1.5px solid var(--ink);
    padding: 0.45rem;
    background: var(--paper);
  }
  .now__fig-cap {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: 0.03em;
    color: var(--mist);
    margin-top: var(--sp-2);
  }
  @media (max-width: 52rem) {
    .now__grid {
      flex-direction: column;
    }
  }
  .now__lead {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: 1.4;
    color: var(--ink);
    margin-top: var(--sp-3);
  }
  .now__text {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    max-width: 46rem;
  }

  @media (max-width: 52rem) {
    .thread {
      grid-template-columns: 1fr;
      row-gap: var(--sp-2);
      padding-block: var(--sp-4);
    }
    .thread__tag {
      padding-top: 0;
    }
  }
</style>
