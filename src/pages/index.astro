---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';

const threads = [
  {
    n: '01',
    title: 'Phase-aware SAR learning',
    body: 'Intensity-only pipelines discard SAR’s phase before the first layer. I build complex-valued, coherence-preserving models that keep it — and use it for change detection.',
    tag: 'complex-valued · InSAR',
  },
  {
    n: '02',
    title: 'Foundation models on new sensors',
    body: 'Every public geospatial foundation model was pretrained on C-band SAR; NISAR is L-band. I’m quantifying where that transfer breaks — and where it surprisingly holds — then closing the gap.',
    tag: 'geo-FMs · NISAR',
  },
  {
    n: '03',
    title: 'Remote sensing for good',
    body: 'The Colombian Amazon is under cloud half the year, and optical deforestation alerts go quiet. I’m building the SAR companion that catches what the operational alerts miss.',
    tag: 'Earth observation · impact',
  },
];
---

<Base>
  <Hero />

  <section class="threads container">
    <div class="rule-label">
      <span class="eyebrow">Research threads</span>
      <span class="eyebrow" style="color:var(--forest)">current focus</span>
    </div>
    <ol class="threads__list">
      {
        threads.map((t) => (
          <li class="thread">
            <span class="thread__n">{t.n}</span>
            <div class="thread__body">
              <h3 class="thread__title">{t.title}</h3>
              <p class="thread__text">{t.body}</p>
              <span class="thread__tag">{t.tag}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="now container">
    <div class="now__grid measure-wide">
      <p class="eyebrow">Now</p>
      <p class="now__lead">
        I'm an <strong>AI Computer Vision Scientist at Privateer&nbsp;Space</strong>, where I
        architected the no-code geospatial ML platform that takes non-experts from raw satellite
        data to deployed models. Before that: KBR, Microsoft, Apple, IMEC, and
        Texas&nbsp;Instruments.
      </p>
      <p class="now__text">
        Whereas most of my career has pushed niche sensing modalities forward for commercial and
        government applications, my deeper passion lies in AI for good — sustainable, local-scale
        answers to humanitarian, agricultural, and environmental problems. <a href="/cv"
          >The full record is in the CV →</a
        >
      </p>
    </div>
  </section>
</Base>

<style>
  .threads {
    margin-top: var(--sp-9);
  }
  .threads__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-6);
  }
  .thread {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-top: var(--sp-4);
    border-top: 2px solid var(--ink);
  }
  .thread__n {
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--forest);
    letter-spacing: 0.02em;
  }
  .thread__title {
    font-size: var(--fs-lg);
  }
  .thread__text {
    color: var(--ink-soft);
    font-size: var(--fs-sm);
  }
  .thread__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: 0.05em;
    color: var(--mist);
    text-transform: uppercase;
    margin-top: auto;
  }

  .now {
    margin-top: var(--sp-9);
  }
  .measure-wide {
    max-width: 54rem;
  }
  .now__lead {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: 1.4;
    color: var(--ink);
    margin-top: var(--sp-3);
  }
  .now__text {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    max-width: 46rem;
  }

  @media (max-width: 52rem) {
    .threads__list {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }
    .thread {
      flex-direction: row;
      align-items: baseline;
      gap: var(--sp-4);
    }
    .thread__n {
      min-width: 2.2rem;
    }
  }
</style>
