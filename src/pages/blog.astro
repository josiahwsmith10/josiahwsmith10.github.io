---
import Base from '@/layouts/Base.astro';
import BlogList, { type PostCard } from '@/components/BlogList.tsx';
import { getCollection } from 'astro:content';
import { formatDate, isoDate, readingTime } from '@/lib/format';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const cards: PostCard[] = posts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  dateLabel: formatDate(p.data.date),
  dateISO: isoDate(p.data.date),
  ts: p.data.date.getTime(),
  minutes: readingTime(p.body),
  tags: p.data.tags,
}));

// All tags, ordered by frequency then alphabetically.
const counts = new Map<string, number>();
for (const c of cards) for (const t of c.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const allTags = [...counts.keys()].sort(
  (a, b) => (counts.get(b)! - counts.get(a)!) || a.localeCompare(b),
);
---
<Base title="Blog — Josiah Smith" description="Notes on SAR, complex-valued networks, and geospatial ML.">
  <div class="blog container">
    <header class="blog__head">
      <p class="eyebrow">Writing</p>
      <h1 class="blog__title">Notes from the signal</h1>
      <p class="blog__lead">
        Write-ups on synthetic aperture radar, complex-valued and phase-aware deep
        learning, and adapting geospatial foundation models to new sensors.
      </p>
    </header>

    <BlogList client:idle posts={cards} allTags={allTags} />
  </div>
</Base>

<style is:global>
  .blog { max-width: 52rem; padding-top: var(--sp-8); }
  .blog__title { font-size: var(--fs-2xl); margin-top: var(--sp-3); }
  .blog__lead {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: var(--sp-4);
    max-width: 42rem;
  }

  .bloglist { margin-top: var(--sp-7); }
  .bloglist__bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-4);
    flex-wrap: wrap;
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--rule);
  }
  .bloglist__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; max-width: 40rem; }
  .tagbtn {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: 0.03em;
    color: var(--mist);
    background: transparent;
    border: 1px solid var(--rule);
    padding: 0.25rem 0.55rem;
    cursor: pointer;
    transition: all 0.14s var(--ease);
  }
  .tagbtn:hover { color: var(--ink); border-color: var(--mist); }
  .tagbtn.is-on {
    color: var(--paper);
    background: var(--forest);
    border-color: var(--forest);
  }
  .bloglist__sort {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--mist);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .bloglist__sort select {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 0.25rem 0.4rem;
    border-radius: 0;
    text-transform: none;
    letter-spacing: 0;
  }
  .bloglist__count {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--mist);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: var(--sp-4);
  }

  .bloglist__list { list-style: none; padding: 0; margin-top: var(--sp-3); }
  .postcard {
    padding: var(--sp-5) 0;
    border-bottom: 1px solid var(--rule);
  }
  .postcard__meta {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .postcard__meta .dot { color: var(--rule); }
  .postcard__title { font-size: var(--fs-lg); margin-top: var(--sp-2); line-height: 1.2; }
  .postcard__title a { color: var(--ink); }
  .postcard__title a:hover { color: var(--forest-deep); text-decoration: none; }
  .postcard__desc {
    margin-top: var(--sp-3);
    color: var(--ink-soft);
    font-size: var(--fs-sm);
    line-height: 1.55;
    max-width: 44rem;
  }
  .postcard__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: var(--sp-4); }
  .postcard__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: 0.03em;
    color: var(--forest-deep);
    background: var(--forest-wash);
    border: 1px solid transparent;
    padding: 0.18rem 0.5rem;
    cursor: pointer;
  }
  .postcard__tag:hover { border-color: var(--forest); }
</style>
