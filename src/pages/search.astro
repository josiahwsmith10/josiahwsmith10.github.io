---
import Base from '@/layouts/Base.astro';
// Pagefind assets (/pagefind/*) are generated by the post-build indexing step,
// so search works on the built/preview site (not in `astro dev`).
---
<Base title="Search — Josiah Smith" description="Search the posts, projects, and CV." noindex={true}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </Fragment>
  <div class="search container">
    <header class="search__head">
      <p class="eyebrow">Search</p>
      <h1 class="search__title">Find a signal</h1>
      <p class="search__lead">Full-text search across posts, projects, and the CV.</p>
    </header>
    <div id="search"></div>
  </div>

  <script is:inline src="/pagefind/pagefind-ui.js" onload="new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false });"></script>
</Base>

<style is:global>
  .search { max-width: 44rem; padding-top: var(--sp-8); }
  .search__title { font-size: var(--fs-2xl); margin-top: var(--sp-3); }
  .search__lead {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    color: var(--ink-soft);
    margin-top: var(--sp-3);
  }
  #search {
    margin-top: var(--sp-6);
    --pagefind-ui-primary: var(--forest);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--paper-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0px;
    --pagefind-ui-font: var(--font-sans);
  }
  #search .pagefind-ui__result-title a { color: var(--ink); }
  #search .pagefind-ui__result-title a:hover { color: var(--forest-deep); }
</style>
